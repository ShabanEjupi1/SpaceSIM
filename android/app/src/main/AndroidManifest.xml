<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 🚨 Deri te 0.1.0 ky aplikacion nuk kërkonte ASNJË leje dhe nuk prekte
         fare rrjetin. Reklamat (0.2.0) e sollën `INTERNET`, dhe kjo ka pasoja
         që nuk duken te kodi: te Play-i «Siguria e të dhënave» kalon nga «nuk
         mblidhet asgjë» te «Identifikues pajisjeje — mblidhen DHE ndahen, për
         reklama», «Advertising ID» kalon nga JO te PO, dhe çdo premtim «pa
         reklama» ose «pa asnjë leje» te listimi bëhet i rremë.
         Vetë aplikacioni mbetet i plotë pa rrjet: katalogu është brenda
         paketës, eSIM-et rrinë në pajisje, QR-i vizatohet vendas. Interneti i
         duhet VETËM reklamës. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- ⚠️ `com.google.android.gms.permission.AD_ID` NUK shkruhet këtu: e shton
         vetë `google_mobile_ads` gjatë bashkimit të manifesteve, dhe Play-i
         shikon manifestin e BASHKUAR te AAB-ja. Shkrimi me dorë nuk prish gjë,
         por fsheh se nga vjen. -->

    <application
        android:label="eSIM Space"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Identifikuesi i aplikacionit te AdMob. Pa këtë rresht aplikacioni
             RRËZOHET në nisje me një përjashtim të qartë nga SDK-ja — jo në
             heshtje, ndaj s'ka si të kalojë pa u vënë re.
             ⚠️ Ky është i eSIM-it (`~8254149674`). Girihu e ka `~4045126137`,
             Shah Mat-i `~3928973421` dhe Tokërrgjiku `~3673667026`: e njëjta
             llogari AdMob, katër aplikacione. Një identifikues i huaj nuk jep
             gabim — jep zero mbushje, që zbulohet vetëm javë më vonë. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-8491001524308476~5982113044"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
